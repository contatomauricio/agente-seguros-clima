# Chave gratuita: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=sua_chave_openweathermap_aqui

# Chave gratuita do Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Nome do modelo Gemini (opcional, tem um default no código)
GEMINI_MODEL=gemini-1.5-flash

# Se true, força cenários climáticos extremos (São Paulo, Fortaleza, Teresina,
# Santos) para testar a geração e o envio simulado de mensagens sem depender
# do clima real no momento da execução.
SIMULAR_EVENTOS_EXTREMOS=false
